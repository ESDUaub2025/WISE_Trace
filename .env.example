VITE_API_URL=/api
VITE_DEMO_MODE=false
VITE_VAPID_PUBLIC_KEY=
# Optional isolated GitHub Pages test build. Use build:file-test; never put tester access keys here.
VITE_FILE_BACKEND_URL=
VITE_BASE_PATH=/
# Server secrets belong in deploy/.env (see deploy/.env.example), never VITE_ variables.
# ANTHROPIC_API_KEY, ANTHROPIC_MODEL, OCR_ENABLED, OCR_CONFIDENCE_THRESHOLD
# VAPID_SUBJECT, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# The local worker schedules tasks; the VPS timer creates encrypted recovery archives.
# RESEND_API_KEY, REPORT_EMAIL_FROM enable monthly email reports.
# ALERT_PROVIDER_URL, ALERT_PROVIDER_TOKEN enable the critical SMS/WhatsApp adapter.
