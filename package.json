{
  "name": "wise_trace",
  "version": "1.0.0",
  "description": "WISE offline-first cooperative traceability and impact",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:production": "node scripts/build-production.mjs",
    "build:file-test": "node scripts/build-file-test.mjs",
    "test:file-test": "playwright test --config playwright.file.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "db:start": "docker compose -f deploy/compose.local.yaml up -d",
    "test:db": "node server/tests/business-rules.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:api": "npm run test:server",
    "server": "node server/index.mjs",
    "showcase:demo": "node scripts/showcase.mjs demo",
    "showcase:clean": "node scripts/showcase.mjs clean",
    "db:migrate": "node server/migrate.mjs",
    "test:server": "node --test server/tests/*.test.mjs"
  },
  "type": "module",
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@tanstack/react-query": "5.104.1",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
